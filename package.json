{
  "name": "@sovereignbase/bytecodec",
  "version": "2.0.1",
  "description": "Runtime-agnostic TypeScript byte codecs for Base45, Base64, UTF-8, gzip, derivation, generation, normalization, concatenation, and comparison.",
  "keywords": [
    "base45",
    "base64url",
    "base64",
    "Uint8Array",
    "bytes",
    "encoding",
    "decoding",
    "browser",
    "web",
    "node",
    "utf8",
    "string",
    "text",
    "qr",
    "equals",
    "compression",
    "gzip",
    "binary",
    "esm",
    "commonjs",
    "cjs",
    "require",
    "bun",
    "deno",
    "edge",
    "edge-runtime",
    "typescript",
    "sovereignbase"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./base45": {
      "types": "./dist/base45/index.d.ts",
      "import": "./dist/base45/index.js",
      "require": "./dist/base45/index.cjs",
      "default": "./dist/base45/index.js"
    },
    "./base64": {
      "types": "./dist/base64/index.d.ts",
      "import": "./dist/base64/index.js",
      "require": "./dist/base64/index.cjs",
      "default": "./dist/base64/index.js"
    },
    "./gzip": {
      "types": "./dist/gzip/index.d.ts",
      "import": "./dist/gzip/index.js",
      "require": "./dist/gzip/index.cjs",
      "default": "./dist/gzip/index.js"
    },
    "./utf8": {
      "types": "./dist/utf8/index.d.ts",
      "import": "./dist/utf8/index.js",
      "require": "./dist/utf8/index.cjs",
      "default": "./dist/utf8/index.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "import": "./dist/util/index.js",
      "require": "./dist/util/index.cjs",
      "default": "./dist/util/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/bytecodec.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/bytecodec/issues"
  },
  "homepage": "https://sovereignbase.dev/bytecodec",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "node scripts/reporting.mjs --start && npm run build && npm run typecheck && npm run test:reports && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:browsers && npm run test:e2e:runtimes",
    "test:e2e:browsers": "playwright test",
    "test:e2e:runtimes": "node scripts/runtime-tests.mjs node bun deno edge cloudflare",
    "test:e2e:node": "node scripts/runtime-tests.mjs node",
    "test:e2e:bun": "node scripts/runtime-tests.mjs bun",
    "test:e2e:deno": "node scripts/runtime-tests.mjs deno",
    "test:e2e:edge": "node scripts/runtime-tests.mjs edge",
    "test:e2e:cloudflare": "node scripts/runtime-tests.mjs cloudflare",
    "bench": "npm run build:package && node benchmark/runner.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run bench",
    "test:reports": "node --test scripts/reporting.test.mjs",
    "reports": "node scripts/reporting.mjs",
    "reports:ci": "node scripts/reporting.mjs --ci",
    "test:base45": "vitest run test/base45 --coverage.enabled=false",
    "bench:base45": "npm run build:package && node benchmark/runner.mjs base45",
    "test:base64": "vitest run test/base64 --coverage.enabled=false",
    "bench:base64": "npm run build:package && node benchmark/runner.mjs base64",
    "test:utf8": "vitest run test/utf8 --coverage.enabled=false",
    "bench:utf8": "npm run build:package && node benchmark/runner.mjs utf8",
    "test:gzip": "vitest run test/gzip --coverage.enabled=false",
    "bench:gzip": "npm run build:package && node benchmark/runner.mjs gzip",
    "test:util": "vitest run test/util --coverage.enabled=false",
    "bench:util": "npm run build:package && node benchmark/runner.mjs util"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "edge-runtime": "^4.0.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true
  }
}
